    {
      "id": 5,
      "type": "table",
      "title": "인증서 현황 (만료 임박 순)",
      "description": "서버가 제시하는 인증서(SAN 이 있는 인증서)를 만료 임박 순으로 표시. 상단 변수로 그룹·서비스·OS·일련번호를 걸러 볼 수 있다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "(ssl_cert_not_after{dnsnames!=\"\", group=~\"$group\", service=~\"$service\", os=~\"$os\", serial_no=~\"$serial_no\"} - time()) / 86400",
          "instant": true,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "emails": true,
              "ips": true,
              "ou": true,
              "module": true
            },
            "renameByName": {
              "instance": "대상",
              "group": "그룹",
              "service": "서비스",
              "os": "OS",
              "cn": "CN",
              "issuer_cn": "발급자",
              "dnsnames": "SAN",
              "serial_no": "일련번호",
