        {
          "expr": "min by (serial_no, cn, issuer_cn) ((ssl_cert_not_after{dnsnames!=\"\", group=~\"$group\", service=~\"$service\", os=~\"$os\", serial_no=~\"$serial_no\"} - time()) / 86400)",
