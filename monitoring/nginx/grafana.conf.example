# /etc/nginx/conf.d/grafana.conf — Grafana 앞단 HTTPS 역프록시 (Rocky: dnf install nginx)
# SELinux: nginx 가 로컬 포트(3000)로 프록시하려면  setsebool -P httpd_can_network_connect on
# 방화벽: firewall-cmd --permanent --add-service=https && firewall-cmd --reload
server {
    listen 80;
    server_name monitor.univ.example;                 # TODO: 감시 서버 호스트명
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name monitor.univ.example;                 # TODO
    ssl_certificate     /etc/pki/tls/certs/monitor.crt;       # TODO: 인증서(처음엔 사내 CA/자체 서명도 가능)
    ssl_certificate_key /etc/pki/tls/private/monitor.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # Grafana Live(웹소켓)
    location /api/live/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
