# Grafana 관리자 계정 (필수). 12자 이상의 강한 비밀번호를 사용하세요.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# 교내 다른 PC 에서 접속하려면 0.0.0.0 으로 바꾸고 앞단에 HTTPS 역프록시를 두세요.
GRAFANA_BIND=127.0.0.1
GRAFANA_ROOT_URL=http://localhost:3000
# certdeploy(발급 서버)가 지표를 푸시할 주소. 발급 서버가 다른 VM 이면 이 VM 의 IP 로 바꾸고 방화벽으로 발급 서버만 허용하세요.
PUSHGATEWAY_BIND=127.0.0.1
